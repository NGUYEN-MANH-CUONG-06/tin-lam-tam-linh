{
  "name": "be",
  "version": "1.0.0",
  "description": "Backend API for Tin Lam Tam Linh",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "postinstall": "prisma generate",
    "test": "node --require ./tests/test-env.js --test --test-concurrency=1 \"tests/*.test.js\"",
    "test:unit": "node --test --test-concurrency=1 tests/demo-reflection.unit.test.js tests/email-verification.unit.test.js tests/mood-ai.test.js tests/mood-idempotency.unit.test.js tests/signal-admin.unit.test.js tests/signal-seed.unit.test.js tests/mvp-draft-import.unit.test.js tests/content-catalog.test.js tests/content-editor.validator.test.js tests/content-review-metadata.test.js tests/culture-publication.test.js tests/ritual-authorship.unit.test.js tests/editorial-workflow.test.js tests/validation.middleware.test.js tests/analytics.test.js tests/admin.test.js tests/payment.test.js tests/privacy.test.js tests/reminder-editor.test.js tests/digital-shop.unit.test.js tests/sepay-ipn.unit.test.js tests/payment-alert.unit.test.js tests/sepay-membership.unit.test.js tests/sepay-reconcile.unit.test.js",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:pull": "prisma db pull",
    "data:wts:validate": "node scripts/validate-wong-tai-sin.js",
    "data:wts:import:dry-run": "node scripts/import-wong-tai-sin.js",
    "test:wts:offline": "node --test --test-concurrency=1 tests/wong-tai-sin-catalog.unit.test.js",
    "data:guanyin:validate": "node scripts/validate-wong-tai-sin.js --manifest=guanyin-100-hk-ctc.json",
    "data:guanyin:import:dry-run": "node scripts/import-wong-tai-sin.js --manifest=guanyin-100-hk-ctc.json",
    "data:original-xam:build": "node scripts/build-original-xam-dataset.js",
    "data:original-xam:validate": "node scripts/validate-original-xam.js",
    "data:original-xam:import:dry-run": "node scripts/import-original-xam.js",
    "data:original-xam:report": "node scripts/build-original-xam-review-report.js",
    "test:original-xam:offline": "node --test --test-concurrency=1 tests/original-xam-catalog.unit.test.js tests/original-xam-gemini.unit.test.js tests/original-xam-publication.unit.test.js tests/original-xam-routing.unit.test.js",
    "data:backfill-private": "node scripts/backfill-private-data.js"
  },
  "keywords": [
    "express",
    "prisma",
    "postgresql",
    "jwt"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "2.24.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "google-auth-library": "^11.2.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "sepay-pg-node": "^1.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^7.10.0"
  }
}
